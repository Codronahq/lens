# dbt
target/
dbt_packages/
dbt_modules/
logs/
.user.yml
profiles.yml

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Data — never commit corpora or extracts
*.parquet
*.duckdb
*.db
data/
!data/.gitkeep

# Environment
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Python packaging / tool caches
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
build/
dist/

# Our dbt profile is committed deliberately: it holds no credentials, only an
# env-var-driven DuckDB path, and a profile that exists solely in ~/.dbt is
# invisible to CI and to anyone cloning the repo. The blanket rule above stays
# in force for every other profiles.yml.
!profiles.yml
profiles/
